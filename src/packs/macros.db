{"_id":"23kTIYmN7vqvmjF5","name":"toggle-playlist-sound","permission":{"default":0,"PEJBB2AYKoE5ZuxD":3},"type":"script","flags":{},"scope":"global","command":"/* This macro requires the advanced macros of Furnace and Playlist QoL\r\n * This will toggle the playing state of a sound in your playlists\r\n * Takes the playlist name as first argument, and the sound name as second argument \r\n * Example: /toggle-playlist-sound \"SFX\" \"Sword Clash\"\r\n */\r\n\r\nFurnacePlaylistQoL.PlaySound(args[0], args[1]);","author":"PEJBB2AYKoE5ZuxD","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"3t22b7DeBqd8OKz6","name":"Canvas Always-on-top","permission":{"default":0,"PEJBB2AYKoE5ZuxD":3},"type":"script","flags":{"furnace":{"runAsGM":false},"core":{"sourceId":"Macro.tHqyy0sqn6mHlV0m"}},"scope":"global","command":"const video = $(`<video id='pip-video' autoplay='autoplay' onplay='this.requestPictureInPicture()'></video>`)[0];\nvideo.srcObject = $(\"#board\")[0].captureStream();\nconst playVideo = () => {\n   if (video.readyState < 2) setTimeout(playVideo, 0);\n   else video.play();\n};\nplayVideo();","author":"PEJBB2AYKoE5ZuxD","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"4aUMx41pvnZCJ52b","name":"teleport","permission":{"FRJk2q4bH9IdLZDf":3},"type":"script","sort":100001,"flags":{},"scope":"global","command":"// This macro only serves as an example. For a proper teleportation macro, check out the Dynamic Effects module.\r\n//\r\n// This macro requires the advanced macros of Furnace\r\n// This macro depends on /move-token\r\n// Takes X and Y as arguments\r\n\r\nconst macro = game.macros.getName(\"move-token\");\r\nif (!macro) {\r\n  ui.notifications.error(\"This macro depends on the 'move-token' macro, which could not be found.\");\r\n  return;\r\n}\r\nmacro.execute(args[0], args[1], true);\r\n","author":"FRJk2q4bH9IdLZDf","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"63bPkXo7BUsZEQJ0","name":"animate-pan","permission":{"default":0,"PEJBB2AYKoE5ZuxD":3},"type":"script","flags":{},"scope":"global","command":"/* Pan the camera to the X, Y and scale positions.\r\n * See the 'pan-camera' macro for more details.\r\n * The first argument is the duration in milliseconds for the panning animation\r\n * The second argument is X, third argument is Y and fourth argument is the zoom level\r\n * Example: /animate-pan 500 1500 1500 0.5\r\n */\r\n\r\ncanvas.animatePan({duration: args[0], x: args[1], y: args[2], scale: args[3]})","author":"PEJBB2AYKoE5ZuxD","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"7g5Bw4kquOY7sr7j","name":"journal-dialog","permission":{"8pIGCEozfXNtPyHL":3},"type":"script","sort":400000,"flags":{},"scope":"global","command":"// This macro requires the advanced macros of Furnace\r\n// This will display the contents of a journal as a dialog\r\n// Takes one argument, the journal name\r\n// Example: /journal-dialog \"Welcome to my world\"\r\n\r\nconst journal = game.journal.entities.find(j => j.name === args[0])\r\nif (!journal) return;\r\nnew Dialog({content: journal.data.content,\r\n            buttons: {ok: {label: args[1] || \"ok\"}}}).render(true)","author":"8pIGCEozfXNtPyHL","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"CRaAk3V9gF6ihk1P","name":"Measure Token Distances","permission":{"default":0,"PEJBB2AYKoE5ZuxD":3},"type":"script","flags":{"furnace":{"runAsGM":false}},"scope":"global","command":"// This macro will measure the distance between the selected tokens\r\n// and every targetted tokens within a scene.\r\n// It will then output the measured distances to the chat\r\n// If called with an argument, determines who to whisper the message to,\r\n// otherwise sends it as a public message\r\n\r\nlet message = \"\"\r\nfor (let token of canvas.tokens.controlled) {\r\n   let ruler = canvas.controls.ruler;\r\n   for (let target of game.user.targets) {\r\n       ruler.clear()\r\n       ruler.waypoints.push(token.center)\r\n       ruler.labels.addChild(new PIXI.Text(\"\"));\r\n       ruler.measure(target.center);\r\n       let distance = ruler.labels.children[0].text;\r\n       message += `From '${token.name}' to '${target.name}' : ${distance}<br/>`\r\n       ruler.clear();\r\n   }\r\n}\r\nif (message) {\r\n   const whisper = args[0] ? ChatMessage.getWhisperIDs(args[0]) : undefined;\r\n   ChatMessage.create({content: message, whisper});\r\n}","author":"PEJBB2AYKoE5ZuxD","img":"icons/svg/dice-target.svg","actorIds":[]}
{"name":"Full Scene vision","permission":{"default":0,"PEJBB2AYKoE5ZuxD":3},"type":"script","flags":{"furnace":{"runAsGM":false},"core":{"sourceId":"Macro.Rpgok2vhQ4nNton4"}},"scope":"global","command":"// This macro will effectively set the vision area in a scene to the entire gridded area\n// without having to shift any walls or tiles or tokens.\n// It will do this by removing the scene padding by setting it to 0,\n//  then changing the scene dimensions so the overall scene keeps the exact same size\n// It will also move the background image into a tile so it can be positiioned \n// at the same position as it was when the scene had padding\n\nconst width = canvas.scene.data.width;\nconst height = canvas.scene.data.height;\nconst grid = canvas.scene.data.grid;\nconst img = canvas.scene.data.img;\nconst padding = canvas.scene.data.padding;\nconst paddingX = Math.ceil(width * padding / grid) * grid;\nconst paddingY = Math.ceil(height * padding / grid) * grid;\n\nawait canvas.scene.update({img: null, width: width + 2 * paddingX, height: height + 2 * paddingY, padding: 0})\nif (img) {\n  const minZ = canvas.scene.data.tiles.length ? Math.min(...canvas.scene.data.tiles.map(t => t.z)) : 0;\n  await canvas.scene.createEmbeddedDocuments('Tile', [{width, height, img, scale: 1, rotation: 0, locked: true, hidden: false, x: paddingX, y: paddingY, z: minZ - 1}]);\n}","author":"PEJBB2AYKoE5ZuxD","img":"icons/svg/dice-target.svg","actorIds":[],"_id":"MO5ZBnOxAMeMy7mU"}
{"_id":"Ns2y2EcwosuZOwtu","name":"roll-skill","permission":{"default":0,"PEJBB2AYKoE5ZuxD":3},"type":"script","flags":{},"scope":"global","command":"/* This macro requires the advanced macros of Furnace and the LMRTFY module, v0.7+\r\n * This will request a skill check for the currently selected player using LMRTFY roll request dialog\r\n * Takes the skill as its first argument, or if not set, requests all\r\n * Example: /roll-skill \"prc\"\r\n */\r\n\r\nconst skill = args[0] || Object.keys(CONFIG.DND5E.skills);\r\nif (!actor) return;\r\nLMRTFYRoller.requestSkillChecks(actor, skill);","author":"PEJBB2AYKoE5ZuxD","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"PoygoBaDDvbDCluL","name":"current-time","permission":{"default":0,"PEJBB2AYKoE5ZuxD":3},"type":"script","flags":{},"scope":"global","command":"// Returns the current time in format \"HH:MM\" (24 hour format)\r\nconst now = new Date();\r\nreturn `${now.getHours()}:${now.getMinutes()}`;","author":"PEJBB2AYKoE5ZuxD","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"T39hRCH2Ozk4oUZU","name":"Restore token creation","permission":{"FRJk2q4bH9IdLZDf":3},"type":"script","sort":100001,"flags":{},"scope":"global","command":"// This will restore your ability (if your player role had it) to drop actors onto a scene to create new tokens.\r\n// This is the complement for the \"Disallow token creation\" macro.\r\n\r\nif (game.disallow_token_creation_id) Hooks.off('preCreateToken', game.disallow_token_creation_id);\r\ngame.disallow_token_creation_id= 0;","author":"FRJk2q4bH9IdLZDf","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"Tu27SXg668TmcI1X","name":"Disallow token creation","permission":{"FRJk2q4bH9IdLZDf":3},"type":"script","sort":100001,"flags":{},"scope":"global","command":"// After running this macro, it will be impossible to drop any new tokens onto the scene, regardless of user permission\r\n// Running the 'Restore token creation' macro will restore the normal behavior.\r\n\r\nif (game.disallow_token_creation_id)\r\n   Hooks.off('preCreatetoken', game.disallow_token_creation_id);\r\ngame.disallow_token_creation_id = Hooks.on(\"preCreateToken\", () => false);","author":"FRJk2q4bH9IdLZDf","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"hbpdu5LvSAOAp5PX","name":"Say hello","permission":{"default":0,"PEJBB2AYKoE5ZuxD":3},"type":"chat","flags":{},"scope":"global","command":"Hi {{game.user.name}}, it is now {{macro \"current-time\"}}","author":"PEJBB2AYKoE5ZuxD","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"rKmHs6LsBtDjPDhK","name":"Set Token bars and nameplate","permission":{"bWT4RleWjkaYiYKA":3},"type":"script","sort":100001,"flags":{},"scope":"global","command":"/* This will set every token in scene to always display their\r\n * token bars and nameplate, and sets the first bar to represent \r\n * HP and removes the second token bar.\r\n*/\r\n\r\nconst tokens =canvas.tokens.placeables.map(token => {\r\n   return {\r\n       _id: token.id,\r\n       \"bar1.attribute\": \"attributes.hp\",\r\n       \"bar2.attribute\": \"\",\r\n       \"displayName\": CONST.TOKEN_DISPLAY_MODES.ALWAYS,\r\n       \"displayBars\": CONST.TOKEN_DISPLAY_MODES.ALWAYS\r\n   };\r\n});\r\n\r\ncanvas.scene.updateEmbeddedDocuments('Token', tokens)","author":"bWT4RleWjkaYiYKA","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"rMOgmYRkV0AZ1sjc","name":"move-token","permission":{"FRJk2q4bH9IdLZDf":3},"type":"script","sort":100001,"flags":{},"scope":"global","command":"/* This macro requires the advanced macros of Furnace\r\n * This will move the selected token to the designated position\r\n * Takes X and Y as arguments for the position (in pixels)\r\n * A third, optional, argument, if set to true, will disable the movement animation\r\n * Example: /move-token 1000 1500 false\r\n */\r\n\r\nconst x = args[0];\r\nconst y = args[1];\r\nconst noAnimate = args[2];\r\n\r\nif (!token) return;\r\nif (noAnimate) token._noAnimate = true;\r\nawait token.document.update({x, y})\r\ntoken._noAnimate = false;","author":"FRJk2q4bH9IdLZDf","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"wg8eFxpVcgewRvsu","name":"pan-camera","permission":{"FRJk2q4bH9IdLZDf":3},"type":"script","sort":100001,"flags":{},"scope":"global","command":"// Pan the canvas camera to a position X and Y, in pixels.\r\n// Can also set the zoom level using the third optional argument.\r\n// Example: /pan-camera 1500\r\n// Example: /pan-camera 2500 2000 0.3\r\n\r\ncanvas.pan({x: args[0], y: args[1], scale: args[2]})","author":"FRJk2q4bH9IdLZDf","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"yUlSqozYscIEOGz1","name":"play-audio","permission":{"FRJk2q4bH9IdLZDf":3},"type":"script","sort":100001,"flags":{},"scope":"global","command":"/* This macro requires the advanced macros of Furnace\r\n * This will play audio from a URL\r\n * Takes the URL of the audio file as its first argument\r\n * The second argument, if set to true, will play the audio for every other player too.\r\n * Example: /play-audio \"https://example.com/sound-effects/explosion.mp3\" true\r\n */\r\nconst url = args[0];\r\nconst push = args[1];\r\n\r\nAudioHelper.play({src: [url]}, push);","author":"FRJk2q4bH9IdLZDf","img":"icons/svg/dice-target.svg","actorIds":[]}
{"_id":"fcGgpdQzgPvTgUKd","name":"Change Token Vision","type":"script","author":"oPuS5iW18dRDcW4r","img":"icons/svg/dice-target.svg","scope":"global","command":"// Open a dialog for quickly changing token vision parameters of the controlled tokens.\n// This macro was written by @Sky#9453\n// https://github.com/Sky-Captain-13/foundry\n\nif (canvas.tokens.controlled.length === 0)\n  return ui.notifications.error(\"Please select a token first\");\n\nlet applyChanges = false;\nnew Dialog({\n  title: `Token Vision Configuration`,\n  content: `\n    <form>\n      <div class=\"form-group\">\n        <label>Vision Type:</label>\n        <select id=\"vision-type\" name=\"vision-type\">\n          <option value=\"nochange\">No Change</option>\n          <option value=\"dim0\">Self</option>\n          <option value=\"dim30\">Darkvision (30 ft)</option>\n          <option value=\"dim60\">Darkvision (60 ft)</option>\n          <option value=\"dim90\">Darkvision (90 ft)</option>\n          <option value=\"dim120\">Darkvision (120 ft)</option>\n          <option value=\"dim150\">Darkvision (150 ft)</option>\n          <option value=\"dim180\">Darkvision (180 ft)</option>\n          <option value=\"bright120\">Devil's Sight (Warlock)</option>\n        </select>\n      </div>\n      <div class=\"form-group\">\n        <label>Light Source:</label>\n        <select id=\"light-source\" name=\"light-source\">\n          <option value=\"nochange\">No Change</option>\n          <option value=\"none\">None</option>\n          <option value=\"candle\">Candle</option>\n          <option value=\"lamp\">Lamp</option>\n          <option value=\"bullseye\">Lantern (Bullseye)</option>\n          <option value=\"hooded-dim\">Lantern (Hooded - Dim)</option>\n          <option value=\"hooded-bright\">Lantern (Hooded - Bright)</option>\n          <option value=\"light\">Light (Cantrip)</option>\n          <option value=\"torch\">Torch</option>\n        </select>\n      </div>\n    </form>\n    `,\n  buttons: {\n    yes: {\n      icon: \"<i class='fas fa-check'></i>\",\n      label: `Apply Changes`,\n      callback: () => applyChanges = true\n    },\n    no: {\n      icon: \"<i class='fas fa-times'></i>\",\n      label: `Cancel Changes`\n    },\n  },\n  default: \"yes\",\n  close: html => {\n    if (applyChanges) {\n      for ( let token of canvas.tokens.controlled ) {\n        let visionType = html.find('[name=\"vision-type\"]')[0].value || \"none\";\n        let lightSource = html.find('[name=\"light-source\"]')[0].value || \"none\";\n        let dimSight = 0;\n        let brightSight = 0;\n        let dimLight = 0;\n        let brightLight = 0;\n        let lightAngle = 360;\n        let lockRotation = token.data.lockRotation;\n        // Get Vision Type Values\n        switch (visionType) {\n          case \"dim0\":\n            dimSight = 0;\n            brightSight = 0;\n            break;\n          case \"dim30\":\n            dimSight = 30;\n            brightSight = 0;\n            break;\n          case \"dim60\":\n            dimSight = 60;\n            brightSight = 0;\n            break;\n          case \"dim90\":\n            dimSight = 90;\n            brightSight = 0;\n            break;\n          case \"dim120\":\n            dimSight = 120;\n            brightSight = 0;\n            break;\n          case \"dim150\":\n            dimSight = 150;\n            brightSight = 0;\n            break;\n          case \"dim180\":\n            dimSight = 180;\n            brightSight = 0;\n            break;\n          case \"bright120\":\n            dimSight = 0;\n            brightSight= 120;\n            break;\n          case \"nochange\":\n          default:\n            dimSight = token.data.dimSight;\n            brightSight = token.data.brightSight;\n        }\n        // Get Light Source Values\n        switch (lightSource) {\n          case \"none\":\n            dimLight = 0;\n            brightLight = 0;\n            break;\n          case \"candle\":\n            dimLight = 10;\n            brightLight = 5;\n            break;\n          case \"lamp\":\n            dimLight = 45;\n            brightLight = 15;\n            break;\n          case \"bullseye\":\n            dimLight = 120;\n            brightLight = 60;\n            lockRotation = false;\n            lightAngle = 52.5;\n            break;\n          case \"hooded-dim\":\n            dimLight = 5;\n            brightLight = 0;\n            break;\n          case \"hooded-bright\":\n            dimLight = 60;\n            brightLight = 30;\n            break;\n          case \"light\":\n            dimLight = 40;\n            brightLight = 20;\n            break;\n          case \"torch\":\n            dimLight = 40;\n            brightLight = 20;\n            break;\n          case \"nochange\":\n          default:\n            dimLight = token.data.dimLight;\n            brightLight = token.data.brightLight;\n            lightAngle = token.data.lightAngle;\n            lockRotation = token.data.lockRotation;\n        }\n        // Update Token\n        console.log(token);\n        token.document.update({\n          vision: true,\n          dimSight: dimSight,\n          brightSight: brightSight,\n          light:{\n               dim: dimLight,\n               bright:  brightLight\n          },\n          lightAngle: lightAngle,\n          lockRotation: lockRotation\n        });\n      }\n    }\n  }\n}).render(true);","folder":null,"sort":0,"permission":{"default":0,"PEJBB2AYKoE5ZuxD":3,"oPuS5iW18dRDcW4r":3},"flags":{"core":{"sourceId":"Compendium.advanced-macros.macros.zEOWQFblsTskw7jX"}}}
{"_id":"Seq1EffectPlay01","name":"sequencer-effect","permission":{"default":0},"type":"script","flags":{},"scope":"global","command":"/* Play a Sequencer visual effect at a location or on a token\r\n * Requires the Sequencer module to be installed and active\r\n * Arguments:\r\n *   args[0] - Effect file path (e.g., \"jb2a.fire_bolt.blue\")\r\n *   args[1] - Target type: \"token\" (selected token), \"target\" (targeted token), or \"position\" (X,Y coordinates)\r\n *   args[2] - X coordinate (only if position mode) or scale multiplier\r\n *   args[3] - Y coordinate (only if position mode)\r\n * Examples:\r\n *   /sequencer-effect \"jb2a.fire_bolt.blue\" \"target\"\r\n *   /sequencer-effect \"jb2a.magic_signs.circle.02.conjuration.intro.blue\" \"token\" 2\r\n *   /sequencer-effect \"jb2a.explosion.01.orange\" \"position\" 1500 2000\r\n */\r\n\r\nif (!game.modules.get(\"sequencer\")?.active) {\r\n   ui.notifications.error(\"Sequencer module must be installed and active\");\r\n   return;\r\n}\r\n\r\nconst effectPath = args[0];\r\nconst targetType = args[1] || \"token\";\r\nconst param1 = args[2];\r\nconst param2 = args[3];\r\n\r\nif (!effectPath) {\r\n   ui.notifications.warn(\"Please provide an effect file path\");\r\n   return;\r\n}\r\n\r\nconst seq = new Sequence();\r\n\r\nswitch(targetType) {\r\n   case \"token\":\r\n       if (!token) {\r\n           ui.notifications.warn(\"No token selected\");\r\n           return;\r\n       }\r\n       seq.effect()\r\n           .file(effectPath)\r\n           .atLocation(token)\r\n           .scale(param1 || 1);\r\n       break;\r\n       \r\n   case \"target\":\r\n       const targets = Array.from(game.user.targets);\r\n       if (targets.length === 0) {\r\n           ui.notifications.warn(\"No targets selected\");\r\n           return;\r\n       }\r\n       targets.forEach(t => {\r\n           seq.effect()\r\n               .file(effectPath)\r\n               .atLocation(t)\r\n               .scale(param1 || 1);\r\n       });\r\n       break;\r\n       \r\n   case \"position\":\r\n       if (param1 === undefined || param2 === undefined) {\r\n           ui.notifications.warn(\"Position mode requires X and Y coordinates\");\r\n           return;\r\n       }\r\n       seq.effect()\r\n           .file(effectPath)\r\n           .atLocation({x: param1, y: param2});\r\n       break;\r\n       \r\n   default:\r\n       ui.notifications.error(`Unknown target type: ${targetType}`);\r\n       return;\r\n}\r\n\r\nseq.play();\r\nui.notifications.info(\"Effect played\");","author":"SequencerMacros01","img":"icons/svg/dice-target.svg","actorIds":[],"sort":200000}
{"_id":"Seq2TeleportFX02","name":"sequencer-teleport","permission":{"default":0},"type":"script","flags":{},"scope":"global","command":"/* Teleport token with visual effects using Sequencer\r\n * Requires Sequencer module and JB2A (Jules&Ben's Animated Assets) or similar\r\n * Arguments:\r\n *   args[0] - Destination X coordinate\r\n *   args[1] - Destination Y coordinate  \r\n *   args[2] - Effect style: \"arcane\", \"divine\", \"nature\", \"fire\", \"lightning\" (default: \"arcane\")\r\n * Example: /sequencer-teleport 2000 1500 \"lightning\"\r\n */\r\n\r\nif (!game.modules.get(\"sequencer\")?.active) {\r\n   ui.notifications.error(\"Sequencer module required\");\r\n   return;\r\n}\r\n\r\nif (!token) {\r\n   ui.notifications.warn(\"Please select a token\");\r\n   return;\r\n}\r\n\r\nconst destX = args[0];\r\nconst destY = args[1];\r\nconst style = args[2] || \"arcane\";\r\n\r\nif (destX === undefined || destY === undefined) {\r\n   ui.notifications.warn(\"Please provide X and Y coordinates\");\r\n   return;\r\n}\r\n\r\nconst effects = {\r\n   arcane: {\r\n       out: \"jb2a.misty_step.01.blue\",\r\n       in: \"jb2a.misty_step.02.blue\"\r\n   },\r\n   divine: {\r\n       out: \"jb2a.misty_step.01.yellow\",\r\n       in: \"jb2a.misty_step.02.yellow\"\r\n   },\r\n   nature: {\r\n       out: \"jb2a.misty_step.01.green\",\r\n       in: \"jb2a.misty_step.02.green\"\r\n   },\r\n   fire: {\r\n       out: \"jb2a.misty_step.01.orange\",\r\n       in: \"jb2a.misty_step.02.orange\"\r\n   },\r\n   lightning: {\r\n       out: \"jb2a.static_electricity.01.blue\",\r\n       in: \"jb2a.static_electricity.01.blue\"\r\n   }\r\n};\r\n\r\nconst selectedEffect = effects[style] || effects.arcane;\r\n\r\nnew Sequence()\r\n   .effect()\r\n       .file(selectedEffect.out)\r\n       .atLocation(token)\r\n       .waitUntilFinished(-500)\r\n   .animation()\r\n       .on(token)\r\n       .opacity(0)\r\n   .wait(200)\r\n   .animation()\r\n       .on(token)\r\n       .teleportTo({x: destX, y: destY})\r\n   .effect()\r\n       .file(selectedEffect.in)\r\n       .atLocation({x: destX, y: destY})\r\n   .animation()\r\n       .on(token)\r\n       .opacity(1)\r\n   .play();\r\n\r\nui.notifications.info(`Teleporting with ${style} effect`);","author":"SequencerMacros01","img":"icons/svg/dice-target.svg","actorIds":[],"sort":200100}
{"_id":"Seq3WeatherFX03","name":"sequencer-weather","permission":{"default":0},"type":"script","flags":{},"scope":"global","command":"/* Create atmospheric weather effects using Sequencer\r\n * Requires Sequencer module and compatible effect libraries\r\n * Arguments:\r\n *   args[0] - Weather type: \"rain\", \"snow\", \"fog\", \"leaves\", \"embers\"\r\n *   args[1] - Duration in milliseconds (default: 10000)\r\n *   args[2] - Intensity 1-3 (default: 2)\r\n * Example: /sequencer-weather \"rain\" 15000 3\r\n */\r\n\r\nif (!game.modules.get(\"sequencer\")?.active) {\r\n   ui.notifications.error(\"Sequencer module required\");\r\n   return;\r\n}\r\n\r\nconst weatherType = args[0] || \"rain\";\r\nconst duration = args[1] || 10000;\r\nconst intensity = Math.min(Math.max(args[2] || 2, 1), 3);\r\n\r\nconst sceneWidth = canvas.scene.dimensions.width;\r\nconst sceneHeight = canvas.scene.dimensions.height;\r\nconst centerX = sceneWidth / 2;\r\nconst centerY = sceneHeight / 2;\r\n\r\nconst weatherEffects = {\r\n   rain: \"jb2a.fog_cloud.2.blue\",\r\n   snow: \"jb2a.fog_cloud.2.white\",\r\n   fog: \"jb2a.fog_cloud.1.grey\",\r\n   leaves: \"jb2a.impact.ground_crack.orange.01\",\r\n   embers: \"jb2a.fire_sprite.orange\"\r\n};\r\n\r\nconst effectFile = weatherEffects[weatherType];\r\n\r\nif (!effectFile) {\r\n   ui.notifications.warn(`Unknown weather type: ${weatherType}. Use: rain, snow, fog, leaves, or embers`);\r\n   return;\r\n}\r\n\r\nconst seq = new Sequence();\r\n\r\nfor (let i = 0; i < intensity; i++) {\r\n   seq.effect()\r\n       .file(effectFile)\r\n       .atLocation({x: centerX, y: centerY})\r\n       .scale(3 + i)\r\n       .opacity(0.3 + (i * 0.1))\r\n       .duration(duration)\r\n       .fadeIn(1000)\r\n       .fadeOut(1000);\r\n}\r\n\r\nseq.play();\r\nui.notifications.info(`${weatherType} weather effect playing for ${duration/1000} seconds`);","author":"SequencerMacros01","img":"icons/svg/dice-target.svg","actorIds":[],"sort":200200}
{"_id":"Seq4AuraEffect04","name":"sequencer-aura","permission":{"default":0},"type":"script","flags":{},"scope":"global","command":"/* Create persistent aura effects on tokens using Sequencer\r\n * Requires Sequencer module\r\n * Arguments:\r\n *   args[0] - Aura type: \"holy\", \"dark\", \"fire\", \"ice\", \"poison\", \"magic\", \"remove\"\r\n *   args[1] - Scale multiplier (default: 1)\r\n * Example: /sequencer-aura \"holy\" 1.5\r\n * Example: /sequencer-aura \"remove\"\r\n */\r\n\r\nif (!game.modules.get(\"sequencer\")?.active) {\r\n   ui.notifications.error(\"Sequencer module required\");\r\n   return;\r\n}\r\n\r\nif (!token) {\r\n   ui.notifications.warn(\"Please select a token\");\r\n   return;\r\n}\r\n\r\nconst auraType = args[0] || \"magic\";\r\nconst scale = args[1] || 1;\r\n\r\nif (auraType === \"remove\") {\r\n   Sequencer.EffectManager.endEffects({ name: `aura-${token.id}` });\r\n   ui.notifications.info(\"Aura removed\");\r\n   return;\r\n}\r\n\r\nconst auraEffects = {\r\n   holy: \"jb2a.divine_smite.caster.yellowwhite\",\r\n   dark: \"jb2a.smoke.puff.centered.grey.2\",\r\n   fire: \"jb2a.fire_sprite.orange\",\r\n   ice: \"jb2a.moonbeam.01.blue\",\r\n   poison: \"jb2a.fog_cloud.2.green\",\r\n   magic: \"jb2a.magic_signs.circle.02.conjuration.loop.blue\"\r\n};\r\n\r\nconst effectFile = auraEffects[auraType];\r\n\r\nif (!effectFile) {\r\n   ui.notifications.warn(`Unknown aura type: ${auraType}`);\r\n   return;\r\n}\r\n\r\nSequencer.EffectManager.endEffects({ name: `aura-${token.id}` });\r\n\r\nnew Sequence()\r\n   .effect()\r\n       .file(effectFile)\r\n       .attachTo(token)\r\n       .scale(scale)\r\n       .opacity(0.8)\r\n       .fadeIn(500)\r\n       .fadeOut(500)\r\n       .persist()\r\n       .name(`aura-${token.id}`)\r\n   .play();\r\n\r\nui.notifications.info(`${auraType} aura applied to ${token.name}`);","author":"SequencerMacros01","img":"icons/svg/dice-target.svg","actorIds":[],"sort":200300}
{"_id":"Seq5CombatFX005","name":"sequencer-combat","permission":{"default":0},"type":"script","flags":{},"scope":"global","command":"/* Play combat visual effects from selected token to target\r\n * Requires Sequencer module and JB2A assets\r\n * Arguments:\r\n *   args[0] - Effect type: \"melee\", \"arrow\", \"firebolt\", \"magic_missile\", \"lightning\"\r\n *   args[1] - Color variant (optional, depends on effect)\r\n * Example: /sequencer-combat \"firebolt\" \"blue\"\r\n * Example: /sequencer-combat \"arrow\"\r\n */\r\n\r\nif (!game.modules.get(\"sequencer\")?.active) {\r\n   ui.notifications.error(\"Sequencer module required\");\r\n   return;\r\n}\r\n\r\nif (!token) {\r\n   ui.notifications.warn(\"Please select a token\");\r\n   return;\r\n}\r\n\r\nconst targets = Array.from(game.user.targets);\r\nif (targets.length === 0) {\r\n   ui.notifications.warn(\"Please target at least one token\");\r\n   return;\r\n}\r\n\r\nconst effectType = args[0] || \"melee\";\r\nconst colorVariant = args[1] || \"\";\r\n\r\nconst combatEffects = {\r\n   melee: `jb2a.melee_generic.slash.01.${colorVariant || \"orange\"}`,\r\n   arrow: \"jb2a.arrow.physical.white.01\",\r\n   firebolt: `jb2a.fire_bolt.${colorVariant || \"orange\"}`,\r\n   magic_missile: `jb2a.magic_missile.${colorVariant || \"blue\"}`,\r\n   lightning: \"jb2a.chain_lightning.primary.blue\",\r\n   eldritch: `jb2a.eldritch_blast.${colorVariant || \"purple\"}`,\r\n   heal: \"jb2a.healing_generic.400px.yellow\"\r\n};\r\n\r\nconst effectFile = combatEffects[effectType];\r\n\r\nif (!effectFile) {\r\n   ui.notifications.warn(`Unknown effect type: ${effectType}`);\r\n   return;\r\n}\r\n\r\nconst seq = new Sequence();\r\n\r\ntargets.forEach((target, index) => {\r\n   if (effectType === \"melee\") {\r\n       seq.effect()\r\n           .file(effectFile)\r\n           .atLocation(target)\r\n           .delay(index * 200);\r\n   } else if (effectType === \"heal\") {\r\n       seq.effect()\r\n           .file(effectFile)\r\n           .attachTo(target)\r\n           .delay(index * 200);\r\n   } else {\r\n       seq.effect()\r\n           .file(effectFile)\r\n           .atLocation(token)\r\n           .stretchTo(target)\r\n           .delay(index * 200);\r\n   }\r\n});\r\n\r\nseq.play();\r\nui.notifications.info(`${effectType} effect played`);","author":"SequencerMacros01","img":"icons/svg/dice-target.svg","actorIds":[],"sort":200400}
{"_id":"Narr1SceneIntro1","name":"narrative-scene-intro","permission":{"default":0},"type":"script","flags":{"advanced-macros":{"runAsGM":true}},"scope":"global","command":"/* Display a cinematic scene introduction with optional visual effects\r\n * Best used by GM to set the scene for players\r\n * Arguments:\r\n *   args[0] - Scene title\r\n *   args[1] - Scene description (can be multi-line with \\n)\r\n *   args[2] - Optional: \"fade\" for fade effect with Sequencer\r\n * Example: /narrative-scene-intro \"The Dark Forest\" \"As you enter the forest, darkness envelops you...\" \"fade\"\r\n */\r\n\r\nconst title = args[0] || \"Scene\";\r\nconst description = args[1] || \"\";\r\nconst effect = args[2];\r\n\r\nconst content = `\r\n<div style=\"text-align: center; padding: 20px; background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); border: 2px solid #d4af37; border-radius: 10px;\">\r\n   <h1 style=\"color: #d4af37; font-size: 2.5em; margin: 0; text-shadow: 2px 2px 4px rgba(0,0,0,0.8); font-family: 'Modesto Condensed', serif;\">${title}</h1>\r\n   <hr style=\"border: 1px solid #d4af37; width: 80%; margin: 15px auto;\">\r\n   <p style=\"color: #e0e0e0; font-size: 1.3em; line-height: 1.6; margin: 20px; font-style: italic; text-shadow: 1px 1px 2px rgba(0,0,0,0.8);\">${description}</p>\r\n</div>\r\n`;\r\n\r\nif (effect === \"fade\" && game.modules.get(\"sequencer\")?.active) {\r\n   new Sequence()\r\n       .effect()\r\n           .file(\"jb2a.fog_cloud.1.black\")\r\n           .atLocation({x: canvas.scene.dimensions.width/2, y: canvas.scene.dimensions.height/2})\r\n           .scale(5)\r\n           .opacity(0.9)\r\n           .duration(3000)\r\n           .fadeIn(1000)\r\n           .fadeOut(1000)\r\n       .play();\r\n}\r\n\r\nChatMessage.create({\r\n   content: content,\r\n   whisper: ChatMessage.getWhisperRecipients(\"GM\").concat(game.users.players.map(u => u.id)),\r\n   speaker: {alias: \"Narrator\"}\r\n});\r\n\r\nui.notifications.info(\"Scene introduction displayed\");","author":"NarrativeMacros1","img":"icons/svg/dice-target.svg","actorIds":[],"sort":300000}
{"_id":"Narr2NPCSpeech02","name":"narrative-npc-speech","permission":{"default":0},"type":"script","flags":{},"scope":"global","command":"/* Format and display NPC dialogue with character styling\r\n * Arguments:\r\n *   args[0] - NPC name\r\n *   args[1] - Dialogue text\r\n *   args[2] - Optional: Emotion (\"angry\", \"happy\", \"sad\", \"mysterious\", \"fearful\")\r\n *   args[3] - Optional: \"whisper\" to send only to GM, or player name\r\n * Example: /narrative-npc-speech \"Eldrin the Wise\" \"Welcome, travelers!\" \"happy\"\r\n * Example: /narrative-npc-speech \"Mysterious Stranger\" \"Beware the shadows...\" \"mysterious\" \"whisper\"\r\n */\r\n\r\nconst npcName = args[0] || \"Unknown NPC\";\r\nconst dialogue = args[1] || \"...\";\r\nconst emotion = args[2] || \"neutral\";\r\nconst whisperTarget = args[3];\r\n\r\nconst emotionStyles = {\r\n   angry: {color: \"#ff4444\", border: \"#cc0000\", icon: \"🔥\"},\r\n   happy: {color: \"#ffeb3b\", border: \"#fdd835\", icon: \"😊\"},\r\n   sad: {color: \"#6495ed\", border: \"#4169e1\", icon: \"😢\"},\r\n   mysterious: {color: \"#9370db\", border: \"#6a0dad\", icon: \"🌙\"},\r\n   fearful: {color: \"#a9a9a9\", border: \"#696969\", icon: \"😰\"},\r\n   neutral: {color: \"#87ceeb\", border: \"#4682b4\", icon: \"💬\"}\r\n};\r\n\r\nconst style = emotionStyles[emotion] || emotionStyles.neutral;\r\n\r\nconst content = `\r\n<div style=\"border-left: 4px solid ${style.border}; padding: 15px; background: rgba(0,0,0,0.3); border-radius: 5px; margin: 10px 0;\">\r\n   <div style=\"display: flex; align-items: center; margin-bottom: 10px;\">\r\n       <span style=\"font-size: 1.5em; margin-right: 10px;\">${style.icon}</span>\r\n       <strong style=\"color: ${style.color}; font-size: 1.3em;\">${npcName}</strong>\r\n   </div>\r\n   <p style=\"color: #e0e0e0; font-size: 1.1em; margin: 0; font-style: italic; padding-left: 35px;\">\"${dialogue}\"</p>\r\n</div>\r\n`;\r\n\r\nconst whisperIds = whisperTarget === \"whisper\" \r\n   ? ChatMessage.getWhisperRecipients(\"GM\")\r\n   : whisperTarget\r\n       ? ChatMessage.getWhisperRecipients(whisperTarget)\r\n       : undefined;\r\n\r\nChatMessage.create({\r\n   content: content,\r\n   whisper: whisperIds,\r\n   speaker: {alias: npcName}\r\n});","author":"NarrativeMacros1","img":"icons/svg/dice-target.svg","actorIds":[],"sort":300100}
{"_id":"Narr3TimePass003","name":"narrative-time-passage","permission":{"default":0},"type":"script","flags":{},"scope":"global","command":"/* Indicate the passage of time with narrative description\r\n * Arguments:\r\n *   args[0] - Time period: \"minutes\", \"hours\", \"days\", \"weeks\", \"months\", \"years\"\r\n *   args[1] - Amount (number)\r\n *   args[2] - Optional: Brief description of what happens\r\n * Example: /narrative-time-passage \"hours\" 8 \"You rest through the night\"\r\n * Example: /narrative-time-passage \"days\" 3 \"Your journey continues across the wasteland\"\r\n */\r\n\r\nconst period = args[0] || \"hours\";\r\nconst amount = args[1] || 1;\r\nconst description = args[2] || \"Time passes...\";\r\n\r\nconst timeIcons = {\r\n   minutes: \"⏱️\",\r\n   hours: \"🕐\",\r\n   days: \"📅\",\r\n   weeks: \"🗓️\",\r\n   months: \"📆\",\r\n   years: \"⏳\"\r\n};\r\n\r\nconst icon = timeIcons[period] || \"⏰\";\r\nconst timeText = `${amount} ${period}`;\r\n\r\nconst content = `\r\n<div style=\"text-align: center; padding: 20px; background: linear-gradient(to right, rgba(0,0,0,0), rgba(74,74,74,0.5), rgba(0,0,0,0)); border-top: 1px solid #888; border-bottom: 1px solid #888; margin: 15px 0;\">\r\n   <div style=\"font-size: 2em; margin-bottom: 10px;\">${icon}</div>\r\n   <h2 style=\"color: #d4af37; margin: 10px 0; font-variant: small-caps;\">${timeText} later...</h2>\r\n   <p style=\"color: #c0c0c0; font-style: italic; margin: 10px 0;\">${description}</p>\r\n</div>\r\n`;\r\n\r\nChatMessage.create({\r\n   content: content,\r\n   speaker: {alias: \"Time\"}\r\n});\r\n\r\nif (game.modules.get(\"sequencer\")?.active) {\r\n   new Sequence()\r\n       .effect()\r\n           .file(\"jb2a.extras.tmfx.border.circle.outpulse.01.fast\")\r\n           .atLocation({x: canvas.scene.dimensions.width/2, y: canvas.scene.dimensions.height/2})\r\n           .scale(4)\r\n           .opacity(0.5)\r\n       .play();\r\n}","author":"NarrativeMacros1","img":"icons/svg/dice-target.svg","actorIds":[],"sort":300200}
{"_id":"Narr4Atmosphere4","name":"narrative-atmosphere","permission":{"default":0},"type":"script","flags":{},"scope":"global","command":"/* Set atmospheric descriptions for mood and immersion\r\n * Arguments:\r\n *   args[0] - Atmosphere type: \"creepy\", \"peaceful\", \"tense\", \"magical\", \"grim\", \"festive\"\r\n *   args[1] - Custom description (optional)\r\n * Example: /narrative-atmosphere \"creepy\"\r\n * Example: /narrative-atmosphere \"peaceful\" \"Birds chirp as a gentle breeze flows through the meadow\"\r\n */\r\n\r\nconst atmosphereType = args[0] || \"peaceful\";\r\nconst customDesc = args[1];\r\n\r\nconst atmospheres = {\r\n   creepy: {\r\n       desc: \"An eerie silence fills the air. Shadows seem to move at the corner of your vision. The hairs on the back of your neck stand up.\",\r\n       color: \"#2d1b2e\",\r\n       icon: \"👻\"\r\n   },\r\n   peaceful: {\r\n       desc: \"A sense of calm washes over you. The gentle sounds of nature create a soothing ambiance. You feel safe here.\",\r\n       color: \"#2e5266\",\r\n       icon: \"🕊️\"\r\n   },\r\n   tense: {\r\n       desc: \"The air is thick with tension. Every sound seems amplified. Something is about to happen.\",\r\n       color: \"#8b0000\",\r\n       icon: \"⚠️\"\r\n   },\r\n   magical: {\r\n       desc: \"The air shimmers with arcane energy. Reality feels thin here. Magic permeates everything.\",\r\n       color: \"#4b0082\",\r\n       icon: \"✨\"\r\n   },\r\n   grim: {\r\n       desc: \"Darkness pervades this place. Hope seems like a distant memory. The weight of despair is palpable.\",\r\n       color: \"#1c1c1c\",\r\n       icon: \"💀\"\r\n   },\r\n   festive: {\r\n       desc: \"Joy and celebration fill the air! Music and laughter echo around you. This is a time of merriment.\",\r\n       color: \"#ffd700\",\r\n       icon: \"🎉\"\r\n   }\r\n};\r\n\r\nconst atmosphere = atmospheres[atmosphereType] || atmospheres.peaceful;\r\nconst description = customDesc || atmosphere.desc;\r\n\r\nconst content = `\r\n<div style=\"padding: 15px; background: linear-gradient(135deg, ${atmosphere.color}22 0%, ${atmosphere.color}44 100%); border: 1px solid ${atmosphere.color}; border-radius: 8px; margin: 10px 0;\">\r\n   <div style=\"text-align: center; font-size: 2em; margin-bottom: 10px;\">${atmosphere.icon}</div>\r\n   <p style=\"color: #e0e0e0; font-size: 1.15em; text-align: center; margin: 0; font-style: italic;\">${description}</p>\r\n</div>\r\n`;\r\n\r\nChatMessage.create({\r\n   content: content,\r\n   speaker: {alias: \"Atmosphere\"}\r\n});","author":"NarrativeMacros1","img":"icons/svg/dice-target.svg","actorIds":[],"sort":300300}
{"_id":"Narr5Cliffhang05","name":"narrative-cliffhanger","permission":{"default":0},"type":"script","flags":{"advanced-macros":{"runAsGM":true}},"scope":"global","command":"/* End session with a dramatic cliffhanger moment\r\n * Arguments:\r\n *   args[0] - The cliffhanger text\r\n *   args[1] - Optional: \"dramatic\" for extra visual effects\r\n * Example: /narrative-cliffhanger \"As the door creaks open, a massive shadow looms before you...\"\r\n * Example: /narrative-cliffhanger \"The ground begins to shake violently!\" \"dramatic\"\r\n */\r\n\r\nconst cliffhangerText = args[0] || \"To be continued...\";\r\nconst dramatic = args[1] === \"dramatic\";\r\n\r\nconst content = `\r\n<div style=\"position: relative; text-align: center; padding: 30px; background: radial-gradient(circle, #1a0000 0%, #000000 100%); border: 3px solid #8b0000; border-radius: 10px; box-shadow: 0 0 20px rgba(139,0,0,0.8);\">\r\n   <h1 style=\"color: #ff0000; font-size: 3em; margin: 0; text-shadow: 0 0 10px #ff0000, 0 0 20px #ff0000; animation: pulse 2s infinite; font-family: 'Modesto Condensed', serif;\">⚠️ CLIFFHANGER ⚠️</h1>\r\n   <hr style=\"border: 2px solid #8b0000; width: 90%; margin: 20px auto;\">\r\n   <p style=\"color: #ffcccc; font-size: 1.5em; line-height: 1.8; margin: 20px; font-style: italic; text-shadow: 2px 2px 4px rgba(0,0,0,0.9);\">${cliffhangerText}</p>\r\n   <h2 style=\"color: #d4af37; margin-top: 30px; font-size: 2em; font-variant: small-caps;\">To Be Continued...</h2>\r\n</div>\r\n<style>\r\n@keyframes pulse {\r\n   0%, 100% { opacity: 1; }\r\n   50% { opacity: 0.7; }\r\n}\r\n</style>\r\n`;\r\n\r\nif (dramatic && game.modules.get(\"sequencer\")?.active) {\r\n   new Sequence()\r\n       .effect()\r\n           .file(\"jb2a.impact.ground_crack.orange.01\")\r\n           .atLocation({x: canvas.scene.dimensions.width/2, y: canvas.scene.dimensions.height/2})\r\n           .scale(3)\r\n       .effect()\r\n           .file(\"jb2a.fog_cloud.1.black\")\r\n           .atLocation({x: canvas.scene.dimensions.width/2, y: canvas.scene.dimensions.height/2})\r\n           .scale(4)\r\n           .opacity(0.8)\r\n           .fadeIn(500)\r\n           .duration(3000)\r\n       .play();\r\n}\r\n\r\nChatMessage.create({\r\n   content: content,\r\n   speaker: {alias: \"End of Session\"}\r\n});\r\n\r\nui.notifications.warn(\"SESSION CLIFFHANGER!\");","author":"NarrativeMacros1","img":"icons/svg/dice-target.svg","actorIds":[],"sort":300400}
{"_id":"Narr6RandomEvt06","name":"narrative-random-event","permission":{"default":0},"type":"script","flags":{},"scope":"global","command":"/* Generate a random narrative event from a predefined list\r\n * Arguments:\r\n *   args[0] - Category: \"encounter\", \"discovery\", \"weather\", \"social\", \"mystery\"\r\n * Example: /narrative-random-event \"encounter\"\r\n * Example: /narrative-random-event \"mystery\"\r\n */\r\n\r\nconst category = args[0] || \"encounter\";\r\n\r\nconst events = {\r\n   encounter: [\r\n       \"A group of merchants traveling in the opposite direction\",\r\n       \"A wounded animal limping across your path\",\r\n       \"Bandits attempting to set up an ambush\",\r\n       \"A traveling bard performing for coins\",\r\n       \"A lost child crying for their parents\",\r\n       \"A patrol of guards on routine duty\",\r\n       \"A mysterious cloaked figure watching from afar\"\r\n   ],\r\n   discovery: [\r\n       \"An ancient shrine partially hidden by vegetation\",\r\n       \"A discarded backpack with supplies\",\r\n       \"Strange symbols carved into a rock\",\r\n       \"A hidden cave entrance behind a waterfall\",\r\n       \"Tracks leading off the main path\",\r\n       \"An old, weathered journal\",\r\n       \"A peculiar glowing stone\"\r\n   ],\r\n   weather: [\r\n       \"Dark clouds gather and it begins to rain heavily\",\r\n       \"A sudden fog rolls in, reducing visibility\",\r\n       \"The temperature drops noticeably\",\r\n       \"A beautiful rainbow appears after the rain\",\r\n       \"Lightning strikes a nearby tree\",\r\n       \"An unseasonably warm breeze blows through\",\r\n       \"Snow begins to fall gently\"\r\n   ],\r\n   social: [\r\n       \"You overhear gossip about recent events in the region\",\r\n       \"A local festival is taking place nearby\",\r\n       \"Two groups are having a heated argument\",\r\n       \"Someone recognizes one of the party members\",\r\n       \"A wanted poster catches your attention\",\r\n       \"You're invited to share a meal with locals\",\r\n       \"Rumors of treasure spread through the crowd\"\r\n   ],\r\n   mystery: [\r\n       \"You find fresh blood but no body\",\r\n       \"Mysterious lights dance in the distance\",\r\n       \"All the birds suddenly go silent\",\r\n       \"You hear a scream cut short\",\r\n       \"Footprints appear that weren't there moments ago\",\r\n       \"A strange humming emanates from underground\",\r\n       \"The shadows seem to move independently\"\r\n   ]\r\n};\r\n\r\nconst eventList = events[category] || events.encounter;\r\nconst selectedEvent = eventList[Math.floor(Math.random() * eventList.length)];\r\n\r\nconst icons = {\r\n   encounter: \"👥\",\r\n   discovery: \"🔍\",\r\n   weather: \"🌦️\",\r\n   social: \"💬\",\r\n   mystery: \"❓\"\r\n};\r\n\r\nconst icon = icons[category] || \"🎲\";\r\n\r\nconst content = `\r\n<div style=\"padding: 20px; background: linear-gradient(135deg, #2a2a4a 0%, #1a1a2a 100%); border: 2px solid #6a5acd; border-radius: 8px;\">\r\n   <div style=\"text-align: center; font-size: 2.5em; margin-bottom: 15px;\">${icon}</div>\r\n   <h3 style=\"color: #6a5acd; text-align: center; margin: 10px 0; font-variant: small-caps;\">Random ${category} Event</h3>\r\n   <hr style=\"border: 1px solid #6a5acd; width: 80%; margin: 15px auto;\">\r\n   <p style=\"color: #e0e0e0; font-size: 1.2em; text-align: center; margin: 15px 0;\">${selectedEvent}</p>\r\n</div>\r\n`;\r\n\r\nChatMessage.create({\r\n   content: content,\r\n   speaker: {alias: \"Random Event\"}\r\n});\r\n\r\nreturn selectedEvent;","author":"NarrativeMacros1","img":"icons/svg/dice-target.svg","actorIds":[],"sort":300500}
{"_id":"Narr7Flashback07","name":"narrative-flashback","permission":{"default":0},"type":"script","flags":{},"scope":"global","command":"/* Create a flashback narrative sequence\r\n * Arguments:\r\n *   args[0] - Time reference (e.g., \"10 years ago\", \"Last winter\")\r\n *   args[1] - Flashback description\r\n *   args[2] - Optional: Player/character name for personal flashback\r\n * Example: /narrative-flashback \"5 years ago\" \"You remember training with your mentor...\"\r\n * Example: /narrative-flashback \"Yesterday\" \"The vision returns to you...\" \"Gandalf\"\r\n */\r\n\r\nconst timeRef = args[0] || \"In the past\";\r\nconst flashbackText = args[1] || \"You remember...\";\r\nconst targetChar = args[2];\r\n\r\nconst content = `\r\n<div style=\"padding: 20px; background: linear-gradient(135deg, #4a4a2a 0%, #2a2a1a 100%); border: 3px double #d4af37; border-radius: 10px; filter: sepia(30%);\">\r\n   <div style=\"text-align: center; margin-bottom: 15px;\">\r\n       <span style=\"font-size: 2em;\">⏮️</span>\r\n       <h2 style=\"color: #d4af37; margin: 10px 0; font-style: italic; font-variant: small-caps;\">Flashback: ${timeRef}</h2>\r\n   </div>\r\n   <hr style=\"border: 1px solid #d4af37; width: 90%; margin: 15px auto;\">\r\n   <p style=\"color: #d4d4aa; font-size: 1.2em; line-height: 1.6; margin: 15px; font-style: italic; text-align: center;\">${flashbackText}</p>\r\n   <div style=\"text-align: center; margin-top: 15px; color: #999; font-size: 0.9em; font-style: italic;\">— Memory Fragment —</div>\r\n</div>\r\n`;\r\n\r\nconst whisperIds = targetChar ? ChatMessage.getWhisperRecipients(targetChar) : undefined;\r\n\r\nif (game.modules.get(\"sequencer\")?.active) {\r\n   new Sequence()\r\n       .effect()\r\n           .file(\"jb2a.fog_cloud.2.white\")\r\n           .atLocation({x: canvas.scene.dimensions.width/2, y: canvas.scene.dimensions.height/2})\r\n           .scale(4)\r\n           .opacity(0.4)\r\n           .duration(4000)\r\n           .fadeIn(1000)\r\n           .fadeOut(1000)\r\n       .play();\r\n}\r\n\r\nChatMessage.create({\r\n   content: content,\r\n   whisper: whisperIds,\r\n   speaker: {alias: \"Memory\"}\r\n});","author":"NarrativeMacros1","img":"icons/svg/dice-target.svg","actorIds":[],"sort":300600}
{"_id":"Narr8Countdown08","name":"narrative-countdown","permission":{"default":0},"type":"script","flags":{"advanced-macros":{"runAsGM":true}},"scope":"global","command":"/* Create a dramatic countdown for timed events\r\n * Arguments:\r\n *   args[0] - Starting number\r\n *   args[1] - Event description\r\n *   args[2] - Interval in seconds between counts (default: 6 for rounds)\r\n * Example: /narrative-countdown 10 \"until the bomb explodes\" 6\r\n * Example: /narrative-countdown 3 \"until the portal closes\" 10\r\n */\r\n\r\nlet count = parseInt(args[0]) || 10;\r\nconst eventDesc = args[1] || \"until the event occurs\";\r\nconst interval = (parseInt(args[2]) || 6) * 1000;\r\n\r\nconst showCountdown = async (remaining) => {\r\n   const urgency = remaining <= 3 ? \"#ff0000\" : remaining <= 5 ? \"#ff8800\" : \"#ffcc00\";\r\n   const size = remaining <= 3 ? \"4em\" : \"3em\";\r\n   \r\n   const content = `\r\n   <div style=\"text-align: center; padding: 25px; background: linear-gradient(135deg, #1a1a1a 0%, #000000 100%); border: 3px solid ${urgency}; border-radius: 10px; box-shadow: 0 0 20px ${urgency}88;\">\r\n       <h1 style=\"color: ${urgency}; font-size: ${size}; margin: 0; text-shadow: 0 0 10px ${urgency}; font-weight: bold;\">${remaining}</h1>\r\n       <p style=\"color: #cccccc; font-size: 1.2em; margin: 10px 0; font-style: italic;\">${eventDesc}</p>\r\n   </div>\r\n   `;\r\n   \r\n   await ChatMessage.create({\r\n       content: content,\r\n       speaker: {alias: \"Countdown\"},\r\n       sound: remaining <= 5 ? \"sounds/notify.wav\" : undefined\r\n   });\r\n   \r\n   if (game.modules.get(\"sequencer\")?.active && remaining <= 3) {\r\n       new Sequence()\r\n           .effect()\r\n               .file(\"jb2a.markers.circle_of_stars.orangeyellow\")\r\n               .atLocation({x: canvas.scene.dimensions.width/2, y: canvas.scene.dimensions.height/2})\r\n               .scale(2)\r\n               .duration(800)\r\n           .play();\r\n   }\r\n};\r\n\r\nconst countdown = setInterval(() => {\r\n   showCountdown(count);\r\n   count--;\r\n   \r\n   if (count < 0) {\r\n       clearInterval(countdown);\r\n       const finalContent = `\r\n       <div style=\"text-align: center; padding: 30px; background: #000000; border: 4px solid #ff0000; border-radius: 10px; box-shadow: 0 0 30px #ff0000;\">\r\n           <h1 style=\"color: #ff0000; font-size: 5em; margin: 0; text-shadow: 0 0 20px #ff0000; animation: shake 0.5s infinite;\">💥 TIME'S UP! 💥</h1>\r\n       </div>\r\n       `;\r\n       ChatMessage.create({\r\n           content: finalContent,\r\n           speaker: {alias: \"Countdown\"}\r\n       });\r\n   }\r\n}, interval);\r\n\r\nui.notifications.warn(`Countdown started: ${count} ${eventDesc}`);","author":"NarrativeMacros1","img":"icons/svg/dice-target.svg","actorIds":[],"sort":300700}
